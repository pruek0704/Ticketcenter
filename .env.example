# Copy to .env and replace placeholders before running Docker Compose.
# Never commit real passwords or JWT secrets.
POSTGRES_DB=ticketcenter
POSTGRES_USER=ticketcenter
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DEMO_SEED=true
DEMO_EMPLOYEE_PASSWORD=CHANGE_ME
DEMO_IT_PASSWORD=CHANGE_ME
DEMO_HR_PASSWORD=CHANGE_ME
DEMO_ADMIN_PASSWORD=CHANGE_ME

# Optional demo agents: leave blank to skip, or set a password before seeding.
DEMO_FAC_PASSWORD=CHANGE_ME
DEMO_FIN_PASSWORD=CHANGE_ME
DEMO_PROC_PASSWORD=CHANGE_ME
